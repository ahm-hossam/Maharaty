{
  "expo": {
    "name": "مهاراتي",
    "slug": "maharaty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "maharaty",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#F5F7FF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.maharaty.app"
    },
    "android": {
      "package": "com.maharaty.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F7FF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F5F7FF",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2F6CFF"
        }
      ],
      "./plugins/withGradleWrapper",
      "./plugins/withGradleProperties",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ca0d1d73-f41e-441d-887d-c171e9ffbdbc"
      }
    },
    "owner": "ah-ho",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ca0d1d73-f41e-441d-887d-c171e9ffbdbc"
    }
  }
}
